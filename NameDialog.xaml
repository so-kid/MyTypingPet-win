<Window x:Class="MyTypingPet.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プリセット名"
        Width="340" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" />
        <TextBox x:Name="NameBox" Margin="0,10,0,0" Padding="4" FontSize="14" TextChanged="NameBox_TextChanged" />
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="OK" Width="80" IsDefault="True" Click="Ok_Click" />
            <Button Content="キャンセル" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
